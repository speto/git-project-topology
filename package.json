{
  "name": "git-project-topology",
  "version": "0.1.0",
  "description": "Resolve a project path into its canonical Git repository and worktree topology.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "git",
    "worktree",
    "repository",
    "topology",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speto/git-project-topology.git"
  },
  "bugs": {
    "url": "https://github.com/speto/git-project-topology/issues"
  },
  "homepage": "https://github.com/speto/git-project-topology#readme",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
